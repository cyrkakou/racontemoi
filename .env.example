# Copy to .env.local for local development only.
# In cPanel, add these values through Setup Node.js App > Environment variables.

HEALTHCHECK_TOKEN=replace-with-at-least-32-random-characters

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cpaneluser_storybook
MYSQL_PASSWORD=replace-with-database-password
MYSQL_DATABASE=cpaneluser_storybook_poc
MYSQL_CONNECTION_LIMIT=3
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Use a private directory outside public_html and, preferably, outside the app root.
# Local example: ./.data
# cPanel example: /home/CPANEL_USER/private/african-storybook-poc
PERSISTENT_STORAGE_DIR=./.data
